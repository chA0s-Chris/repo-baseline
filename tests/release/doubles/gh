#!/usr/bin/env bash
# Test double for the gh calls of the release scripts, backed by the fake GitHub state in $DOUBLE_STATE/releases.
#
# A release is a directory $DOUBLE_STATE/releases/<tag> (with the slash of tool/v<version>) with the files draft,
# prerelease, latest, title and body and an assets directory. An asset with a marker file of the same name in the
# starter directory is the empty, incomplete asset that GitHub leaves behind when an upload fails upstream.
# "--json <field>" prints what the scripts' "--jq" expression extracts from that field.
# DOUBLE_GH_HIDE_DRAFTS=1 hides drafts like a read-only token does. DOUBLE_GH_FAIL_UPLOAD=<asset name> fails the upload
# of that asset, DOUBLE_GH_STARTER_UPLOAD=<asset name> fails it after leaving an incomplete asset behind.
# Deleting a complete asset is recorded in $DOUBLE_STATE/deleted-uploaded-assets, so the tests can reject it, and
# changing a published release is recorded in $DOUBLE_STATE/changed-published-releases.
set -euo pipefail

{
    printf 'gh'
    printf ' %q' "$@"
    printf '\n'
} >>"$DOUBLE_CALLS"

releases="$DOUBLE_STATE/releases"
mkdir -p "$releases"

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

# Records a change to the published release $1, which immutable releases do not allow.
guard_published() {
    if [[ $(<"$1/draft") == false ]]; then
        printf '%s\n' "${1#"$releases"/}" >>"$DOUBLE_STATE/changed-published-releases"
        die "HTTP 422: Cannot modify an immutable release"
    fi
}

# Sets the flags of release $1 from the remaining arguments.
apply_flags() {
    local release="$1"
    shift
    for argument in "$@"; do
        case "$argument" in
            --draft | --draft=true) printf 'true\n' >"$release/draft" ;;
            --draft=false) printf 'false\n' >"$release/draft" ;;
            --prerelease | --prerelease=true) printf 'true\n' >"$release/prerelease" ;;
            --prerelease=false) printf 'false\n' >"$release/prerelease" ;;
            --latest | --latest=true) printf 'true\n' >"$release/latest" ;;
            --latest=false) printf 'false\n' >"$release/latest" ;;
        esac
    done
}

release_view() {
    local tag="$1" field="" expression="" release asset name state
    shift
    while (($# > 0)); do
        case "$1" in
            --json) field="$2"; shift ;;
            --jq) expression="$2"; shift ;;
        esac
        shift
    done

    release="$releases/$tag"
    [[ -d $release ]] || die "release not found"
    [[ -z ${DOUBLE_GH_HIDE_DRAFTS:-} || $(<"$release/draft") == false ]] || die "release not found"

    case "$field" in
        isDraft) cat "$release/draft" ;;
        body) cat "$release/body" ;;
        assets)
            [[ $expression == '.assets[] | [.name, .state] | @tsv' ]] ||
                die "gh double: unsupported assets expression $expression"
            while IFS= read -r asset; do
                name="$(basename "$asset")"
                state=uploaded
                [[ ! -e $release/starter/$name ]] || state=starter
                printf '%s\t%s\n' "$name" "$state"
            done < <(find "$release/assets" -type f | LC_ALL=C sort)
            ;;
        *) die "gh double: unsupported field $field" ;;
    esac
}

release_create() {
    local tag="$1" notes="" title="" verify=false release
    shift
    local -a arguments=("$@")
    while (($# > 0)); do
        case "$1" in
            --notes-file) notes="$2"; shift ;;
            --title) title="$2"; shift ;;
            --verify-tag) verify=true ;;
            --*) ;;
            *) die "gh double: release create does not support assets" ;;
        esac
        shift
    done

    release="$releases/$tag"
    [[ ! -e $release ]] || die "a release with the same tag name already exists: $tag"
    if [[ $verify == true ]]; then
        "$REAL_GIT" --git-dir="$DOUBLE_ORIGIN" rev-parse --quiet --verify "refs/tags/$tag" >/dev/null ||
            die "tag $tag doesn't exist in the repo"
    fi

    mkdir -p "$release/assets"
    printf 'false\n' >"$release/draft"
    printf 'false\n' >"$release/prerelease"
    printf 'true\n' >"$release/latest"
    printf '%s\n' "$title" >"$release/title"
    cp "$notes" "$release/body"
    apply_flags "$release" "${arguments[@]}"
    printf 'https://github.com/chA0s-Chris/repo-baseline/releases/tag/%s\n' "$tag"
}

release_upload() {
    local tag="$1" clobber=false release name
    shift
    local -a files=()
    for argument in "$@"; do
        case "$argument" in
            --clobber) clobber=true ;;
            *) files+=("$argument") ;;
        esac
    done

    release="$releases/$tag"
    [[ -d $release ]] || die "release not found"
    guard_published "$release"

    for file in "${files[@]}"; do
        name="$(basename "$file")"
        [[ $clobber == true || ! -e $release/assets/$name ]] ||
            die "asset under the same name already exists: [$name]"
        [[ $name != "${DOUBLE_GH_FAIL_UPLOAD:-}" ]] || die "HTTP 502: Server Error"
        if [[ $name == "${DOUBLE_GH_STARTER_UPLOAD:-}" ]]; then
            mkdir -p "$release/starter"
            : >"$release/assets/$name"
            : >"$release/starter/$name"
            die "HTTP 502: Server Error"
        fi
        cp "$file" "$release/assets/"
    done
}

release_delete_asset() {
    local tag="$1" name="$2" confirmed=false release
    shift 2
    for argument in "$@"; do
        [[ $argument != --yes && $argument != -y ]] || confirmed=true
    done

    release="$releases/$tag"
    [[ $confirmed == true ]] || die "--yes required when not running interactively"
    [[ -d $release ]] || die "release not found"
    guard_published "$release"
    [[ -e $release/assets/$name ]] || die "asset $name not found in release $tag"

    if [[ -e $release/starter/$name ]]; then
        rm "$release/starter/$name"
    else
        printf '%s %s\n' "$tag" "$name" >>"$DOUBLE_STATE/deleted-uploaded-assets"
    fi
    rm "$release/assets/$name"
}

release_edit() {
    local tag="$1"
    shift
    [[ -d $releases/$tag ]] || die "release not found"
    guard_published "$releases/$tag"
    apply_flags "$releases/$tag" "$@"
}

case "${1-} ${2-}" in
    "release view") shift 2; release_view "$@" ;;
    "release create") shift 2; release_create "$@" ;;
    "release upload") shift 2; release_upload "$@" ;;
    "release edit") shift 2; release_edit "$@" ;;
    "release delete-asset") shift 2; release_delete_asset "$@" ;;
    *) die "gh double: unsupported call $*" ;;
esac
