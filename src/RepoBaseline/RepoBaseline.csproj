<Project Sdk="Microsoft.NET.Sdk">
  <!-- Warnings are errors only in this repository's CI (-p:TreatWarningsAsErrors=true), never when the tool runs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The tool runs on the newest runtime that is installed, also a later major version. -->
    <RollForward>Major</RollForward>
    <RootNamespace>Chaos.RepoBaseline</RootNamespace>
    <AssemblyName>Chaos.RepoBaseline</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The .NET tool. CI packs it with the version 0.0.0-dev.g<short commit>, and the tool's release workflow with the
       version it releases. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>repo-baseline</ToolCommandName>
    <PackageId>Chaos.RepoBaseline</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Christian Flessa</Authors>
    <Description>Copies the shared files of repo-baseline into a repository and checks that they stay unchanged there.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/chA0s-Chris/repo-baseline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chA0s-Chris/repo-baseline</RepositoryUrl>
    <PackageTags>repository;baseline;editorconfig;resharper;sync</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Records the repository and the commit in the package, so that the release workflow can check which commit a
         published version was built from. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chaos.RepoBaseline.Tests" />
  </ItemGroup>
</Project>
